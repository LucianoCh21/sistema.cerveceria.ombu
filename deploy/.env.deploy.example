# Plantilla de deploy/.env (copiar a deploy/.env y completar).
# deploy/.env NUNCA se commitea (.gitignore lo excluye) y se pasa en privado.
# Generar valores con:  openssl rand -hex 16

# --- Modo de publicación ---
# Túnel (laptop + cloudflared): ":80"  ·  VM con dominio propio: "ombu.midominio.com"
SITE_ADDRESS=:80
# Túnel: dejar en 127.0.0.1 (cloudflared se conecta localmente).
# VM: "80" y "443" (públicos).
CADDY_HTTP_PORT=127.0.0.1:8088
CADDY_HTTPS_PORT=127.0.0.1:8443
# Modo VM: correo para Let's Encrypt (avisos de vencimiento del certificado)
ACME_EMAIL=
# Origen público (túnel: http://localhost · VM: https://<dominio>)
CLIENT_ORIGIN=http://localhost

# --- Acceso a las páginas (basic_auth de Caddy, no aplica a /api/*) ---
BASIC_AUTH_USER=tribunal
BASIC_AUTH_PASSWORD=

# --- SQL Server (mín. 8 caracteres con mayúscula, minúscula, número y símbolo) ---
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=ombu
RABBITMQ_PASS=

# --- Tokens RBAC de la API (también se inyectan al config.js del cliente) ---
ADMIN_TOKEN=
TERMINAL_TOKEN=
DEMO_MODE=true

# --- Puertos internos: SIEMPRE en 127.0.0.1 (solo accesibles desde esta máquina) ---
DB_PORT=127.0.0.1:14330
REDIS_PORT=127.0.0.1:16380
RABBITMQ_PORT=127.0.0.1:15680
RABBITMQ_MGMT_PORT=127.0.0.1:15690
PORT=127.0.0.1:13000
CLIENT_PORT=127.0.0.1:18080
